# 어떤 서비스를 함께 띄울지. 이 줄이 있으면 `docker compose up --build` 한 줄로
# 끝납니다 — 매번 --profile 을 붙일 필요가 없습니다.
#   (비움)   api + web 만. 룰셋·OCR 만 동작 (GPU 불필요)
#   llm      + 로컬 텍스트 모델
#   llm,vlm  + 이미지 자체 판정용 멀티모달 모델
COMPOSE_PROFILES=llm

# --- 가장 쉬운 길: Claude Code 구독 그대로 쓰기 ---
# GPU도, 모델 다운로드도, WSL2 UVA 문제도 없습니다. 텍스트 분석과 이미지
# 판정이 같은 엔드포인트로 갑니다.
#
#   run.bat claude      (또는  ./run.sh claude)
#
# 이 한 줄이면 아래 값들을 알아서 넣어 주므로 .env를 고칠 필요가 없습니다.
# 직접 띄우고 싶다면 `python bridge/claude_bridge.py` 를 호스트에서 실행하고
# 아래를 이렇게 두세요:
#   COMPOSE_PROFILES=
#   LLM_BASE_URL=http://host.docker.internal:8787/v1
#   LLM_MODEL=sonnet
#   VLM_BASE_URL=http://host.docker.internal:8787/v1
#   VLM_MODEL=sonnet
#   LLM_API_KEY=<CLAUDE_BRIDGE_TOKEN 과 같은 값>   ← 토큰을 걸었다면

# LLM 엔드포인트 (OpenAI 호환이면 무엇이든)
#   Claude Code 다리   : http://host.docker.internal:8787/v1  ← 모델 이름은 sonnet
#   compose llm 프로필 : http://llm:8000/v1          ← 아래 HF_HOME_HOST 사용
#   호스트의 vLLM      : http://host.docker.internal:8000/v1
#   Ollama             : http://host.docker.internal:11434/v1
#   OpenAI             : https://api.openai.com/v1
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_API_KEY=not-needed
LLM_TIMEOUT=120

# --- compose의 llm 프로필로 로컬 모델을 직접 서빙할 때만 필요 ---
# HuggingFace 캐시 "루트" 경로. hub 폴더의 부모를 적습니다.
#   Windows 예: D:\huggingface_cache\hub  →  D:/huggingface_cache
#   Linux/macOS 예: ~/.cache/huggingface
# 비워 두면 compose가 프로젝트 폴더 아래 ./hf-cache 를 씁니다.
HF_HOME_HOST=./hf-cache
HF_HUB_OFFLINE=1
LLM_MAX_MODEL_LEN=8192
LLM_GPU_UTIL=0.90
# Windows(WSL2)에서 "RuntimeError: UVA is not available" 방지.
# compose 기본값이 1이라 보통 손댈 일 없습니다.
VLLM_WSL2_ENABLE_PIN_MEMORY=1
# 위 플래그로도 UVA가 안 잡힐 때만 0으로. 비워두면 전달되지 않습니다.
# VLLM_USE_V2_MODEL_RUNNER=0

# --- 이미지 점검 ---
# ① 이미지 속 문구를 OCR로 읽어 기존 룰셋에 태웁니다. GPU 불필요, 기본 켜짐.
#
# 어떤 OCR로 읽을지.
#   auto      PaddleOCR 한국어 모델이 있으면 그것, 없으면 tesseract (기본)
#   paddle    PaddleOCR만. 없으면 이미지 점검을 실패로 남깁니다
#   tesseract 예전 동작 그대로
# PaddleOCR 한국어 모델(korean_PP-OCRv4_rec)은 tesseract보다 국내 배너를
# 훨씬 잘 읽지만 이미지가 ~1.5GB 커집니다. 빌드에서 빼려면 WITH_PADDLE=0.
OCR_ENGINE=auto
WITH_PADDLE=1

# PaddleOCR 모델을 못 받으면 빌드를 실패시킬지. 기본은 0 — 못 받아도 빌드는
# 끝나고 tesseract로 돕니다. PaddleOCR은 더 잘 읽는 선택지이지 이 도구가 도는
# 조건이 아니고, 모델 CDN이 막힌 사내망에서 도구 전체를 못 쓰게 되는 쪽이
# 훨씬 나쁩니다. 못 받은 이유는 GET /healthz의 ocr_note에 그대로 나옵니다.
PADDLE_REQUIRED=0
# 결과 화면의 "읽은 엔진" 표시로 무엇이 실제로 돌았는지 확인할 수 있습니다.

MAX_IMAGES=8               # 한 페이지에서 볼 이미지 장수
MAX_IMAGE_BYTES=5000000    # 장당 상한
MAX_TOTAL_IMAGE_BYTES=20000000   # 한 요청의 이미지 총량
MAX_IMAGE_PIXELS=40000000  # 확대 후 픽셀 수 상한 (압축 폭탄 방어)
MIN_IMAGE_BYTES=3000       # 이보다 작으면 아이콘·추적 픽셀로 보고 건너뜀
MIN_IMAGE_SIDE=150         # 한 변이 이보다 작으면 건너뜀
OCR_LANGS=kor+eng          # tesseract 엔진일 때만 쓰입니다
OCR_TIMEOUT=12             # tesseract 1회 실행 상한(초)
OCR_BUDGET=25              # 이미지 한 장에 쓸 총 시간(초)
OCR_PAGE_BUDGET=90         # 한 페이지 전체 OCR 시간(초)
OCR_MIN_LINE_CONF=55       # 이 신뢰도 미만인 줄은 버림 (잡음 제거)
OCR_CONCURRENCY=2          # 동시에 도는 OCR 개수
OCR_TEXT_PREVIEW=600       # 응답에 실을 OCR 원문 길이

# 한 번의 점검이 이 시간을 넘기면 504로 끊습니다.
CHECK_DEADLINE=180

# --- 점검 이력 ---
# 같은 URL을 다시 점검하면 "3건 해결, 1건 새로 생김, 점수 42 → 78"처럼
# 지난번과의 차이를 보여줍니다. ./data 로 마운트돼 재빌드해도 남습니다.
CHECK_HISTORY_LOG=/app/data/history.jsonl
CHECK_HISTORY_KEEP=20

# ② 이미지 "자체"를 판정합니다 (비포·애프터 사진, 노출 등 글자 없는 문제).
#    멀티모달 엔드포인트가 필요하고, 요청에 use_vlm=true를 줘야 동작합니다.
#    비워두면 이 단계만 조용히 빠집니다.
#    compose vlm 프로필을 쓸 때:  VLM_BASE_URL=http://vlm:8000/v1
VLM_BASE_URL=
VLM_MODEL=
# vlm 프로필이 실제로 서빙할 모델. 캐시에 있는 이름이어야 합니다.
VLM_SERVE_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
VLM_GPU_UTIL=0.30

# --- Claude Code 다리 (bridge/claude_bridge.py) 설정 ---
# 호스트에서 도는 쪽이라 여기 값은 다리를 직접 띄울 때만 읽힙니다.
CLAUDE_BRIDGE_PORT=8787
CLAUDE_BRIDGE_MODEL=sonnet
CLAUDE_BRIDGE_TIMEOUT=180
CLAUDE_BRIDGE_CONCURRENCY=2
# 다리는 컨테이너가 닿아야 해서 0.0.0.0에 붙습니다 = 같은 네트워크의 다른
# 기기도 호출할 수 있습니다. 공용 와이파이라면 여기에 아무 문자열이나 넣고
# 위 LLM_API_KEY에 같은 값을 쓰세요.
CLAUDE_BRIDGE_TOKEN=

# 토큰 사용량 장부. http://localhost:3000/usage 화면이 이걸 읽어 보여줍니다.
# 비워두면 파일에 안 남기고 메모리에만 둡니다(다리를 끄면 사라집니다).
CLAUDE_BRIDGE_USAGE_LOG=usage.jsonl
CLAUDE_BRIDGE_USAGE_KEEP=500

# 프론트엔드가 호출할 API 주소
NEXT_PUBLIC_API_URL=http://localhost:8080

# API가 허용할 오리진 (쉼표 구분)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# 접근 제어
# ---------------------------------------------------------------------------
# 포트를 어느 주소에 열지. 기본 127.0.0.1 = 이 컴퓨터에서만 접속.
# 같은 네트워크의 다른 기기와 나눠 쓰려면 0.0.0.0 — 이때는 API_KEY를 꼭 거세요.
BIND_ADDR=127.0.0.1
# 비워 두면 인증 없음. 값을 넣으면 /v1/* 가 X-API-Key(또는 Bearer) 헤더를 요구한다.
# 웹 화면에도 같은 값이 빌드 때 들어간다 — 웹 화면을 열 수 있는 사람은 키를 볼 수
# 있으니, 웹까지 막으려면 앞단 리버스 프록시에서 인증을 거세요.
API_KEY=
# /v1/check 를 클라이언트 IP당 분당 몇 번까지 받을지. 0이면 끈다.
# 리버스 프록시 뒤라면 모든 요청이 프록시 IP 하나로 세어진다.
RATE_LIMIT_PER_MIN=20

# ---------------------------------------------------------------------------
# 배치 점검 (/v1/batch)
# ---------------------------------------------------------------------------
# 한 배치 안에서 동시에 돌릴 건수. 점검 하나가 페이지 여러 개를 가져오므로 크게 잡지 마세요.
BATCH_CONCURRENCY=2
# 작업 결과 보관 시간(초)과 동시에 둘 작업 수. 메모리에만 있고 재시작하면 사라집니다.
BATCH_TTL=3600
BATCH_MAX_JOBS=20
